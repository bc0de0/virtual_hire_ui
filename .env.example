# Copy to .env.local for npm run dev (Vite loads .env* files automatically).
# Build-time fallback used when public/env-config.js's apiBaseUrl is null.
# Docker deployments should set API_BASE_URL instead (see docker-compose.yml) -
# that overrides this at container start without a rebuild.
VITE_API_BASE_URL=http://10.10.24.196:8000
